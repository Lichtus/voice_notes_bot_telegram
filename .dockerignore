*.db-shm
*.db-wal
*.db-journal
data/

# Repo i narzędzia
.git/
.gitignore
.claude/
.idea/
.vscode/

# Legacy / dokumentacja — niepotrzebne w obrazie
.app_old.py
skrypt.py
requirements.txt
*.md
